  {"id": "d12", "who": "pumpkin", "shot": "2-3", "t": 46.0, "text": "Onward!", "emo": "heroic battle cry, pumped", "exag": 0.85, "cfg": 0.35},
  {"id": "d13", "who": "pip", "shot": "2-3", "t": 49.0, "text": "It stopped.", "emo": "flat, dry", "exag": 0.45, "cfg": 0.5},
  {"id": "d14", "who": "pumpkin", "shot": "2-3", "t": 53.5, "text": "Onward... harder!", "emo": "straining, grunting, determined", "exag": 0.8, "cfg": 0.35},
