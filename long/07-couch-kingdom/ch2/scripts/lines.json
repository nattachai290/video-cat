  {"id": "d17", "who": "pip", "shot": "2-3", "t": 61.5, "text": "Impressive. Backwards.", "emo": "dry sarcasm", "exag": 0.5, "cfg": 0.45},
  {"id": "d18", "who": "troll", "shot": "2-4", "t": 66.0, "text": "Halt! Nobody crosses my bridge without answering three riddles!", "emo": "booming, theatrical troll", "exag": 0.85, "cfg": 0.35},
  {"id": "d19", "who": "troll", "shot": "2-4", "t": 72.0, "text": "What crunches, crumbles, and vanishes when you are near?", "emo": "dramatic riddle, slow", "exag": 0.7, "cfg": 0.4},
  {"id": "d20", "who": "pumpkin", "shot": "2-4", "t": 76.5, "text": "...Snack?", "emo": "unsure guess", "exag": 0.6, "cfg": 0.4},
