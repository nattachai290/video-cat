  {"id": "d00", "who": "pumpkin", "shot": "2-1", "t": 6.0, "text": "A hero's welcome!", "emo": "proud, grand, arms spread", "exag": 0.8, "cfg": 0.35},
  {"id": "d01", "who": "pip", "shot": "2-1", "t": 10.5, "text": "It's food falling from the ceiling.", "emo": "flat deadpan, dry", "exag": 0.45, "cfg": 0.5},
