  {"id": "d07", "who": "oracle", "shot": "2-2", "t": 33.0, "text": "...Eventually.", "emo": "vague, mysterious, slow", "exag": 0.5, "cfg": 0.45},
  {"id": "d08", "who": "pip", "shot": "2-2", "t": 35.5, "text": "Where's the dragon?", "emo": "practical, a bit impatient", "exag": 0.55, "cfg": 0.45},
  {"id": "d09", "who": "oracle", "shot": "2-2", "t": 37.5, "text": "Go right.", "emo": "mysterious, slow", "exag": 0.5, "cfg": 0.45},
