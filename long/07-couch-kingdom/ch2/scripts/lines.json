  {"id": "d22", "who": "troll", "shot": "2-4", "t": 80.0, "text": "What is round, has a hole, and is gone by morning?", "emo": "dramatic riddle", "exag": 0.7, "cfg": 0.4},
  {"id": "d23", "who": "pumpkin", "shot": "2-4", "t": 84.0, "text": "Donut. A snack.", "emo": "confident, pleased", "exag": 0.65, "cfg": 0.4},
  {"id": "d24", "who": "troll", "shot": "2-4", "t": 86.0, "text": "Correct!", "emo": "even more shocked", "exag": 0.85, "cfg": 0.35},
  {"id": "d25", "who": "troll", "shot": "2-4", "t": 88.0, "text": "What am I thinking about right now?", "emo": "sneaky, desperate last riddle", "exag": 0.75, "cfg": 0.4},
  {"id": "d26", "who": "pumpkin", "shot": "2-4", "t": 91.8, "text": "...Snack?", "emo": "deadpan, certain", "exag": 0.45, "cfg": 0.5},
  {"id": "d27", "who": "troll", "shot": "2-4", "t": 93.0, "text": "...Correct.", "emo": "defeated, voice breaking, about to cry", "exag": 0.8, "cfg": 0.35},
  {"id": "d28", "who": "troll", "shot": "2-5", "t": 96.0, "text": "I lost my other half... in the wash.", "emo": "heartbroken, sobbing", "exag": 0.85, "cfg": 0.35},
  {"id": "d29", "who": "pip", "shot": "2-5", "t": 102.0, "text": "Pumpkin. Your cape.", "emo": "pointed, knowing", "exag": 0.5, "cfg": 0.45},
  {"id": "d30", "who": "pumpkin", "shot": "2-5", "t": 104.0, "text": "No. It's my cape. I look heroic.", "emo": "stubborn, proud", "exag": 0.7, "cfg": 0.4},
  {"id": "d31", "who": "pip", "shot": "2-5", "t": 107.5, "text": "You look like laundry.", "emo": "dry deadpan", "exag": 0.45, "cfg": 0.5},
  {"id": "d32", "who": "troll", "shot": "2-5", "t": 109.5, "text": "My other half!", "emo": "overjoyed, shouting", "exag": 0.85, "cfg": 0.35},
  {"id": "d33", "who": "pumpkin", "shot": "2-5", "t": 112.5, "text": "But... my heroic look!", "emo": "whiny, pleading", "exag": 0.75, "cfg": 0.4},
  {"id": "d34", "who": "pip", "shot": "2-5", "t": 115.5, "text": "You can be a hero without wearing laundry.", "emo": "gentle, softening", "exag": 0.55, "cfg": 0.45},
  {"id": "d35", "who": "troll", "shot": "2-5", "t": 124.5, "text": "We're together again!", "emo": "overcome with joy, happy tears", "exag": 0.85, "cfg": 0.35},
  {"id": "d36", "who": "pumpkin", "shot": "2-5", "t": 127.5, "text": "...I miss my laundry.", "emo": "shivering, sad, cold", "exag": 0.7, "cfg": 0.4},
  {"id": "d37", "who": "troll", "shot": "2-5", "t": 130.5, "text": "You may cross! My bridge is open to you!", "emo": "kind, grand, generous", "exag": 0.8, "cfg": 0.35},
  {"id": "d38", "who": "pip", "shot": "2-6", "t": 141.0, "text": "Don't eat the bridge.", "emo": "firm, scolding", "exag": 0.6, "cfg": 0.4},
  {"id": "d39", "who": "pumpkin", "shot": "2-6", "t": 143.5, "text": "I'm inspecting it.", "emo": "pretending to be professional", "exag": 0.55, "cfg": 0.45},
  {"id": "d40", "who": "pip", "shot": "2-6", "t": 145.5, "text": "With your mouth?", "emo": "incredulous", "exag": 0.6, "cfg": 0.4},
  {"id": "d41", "who": "pumpkin", "shot": "2-6", "t": 147.5, "text": "Quality control.", "emo": "confident, mouth full", "exag": 0.55, "cfg": 0.45},
  {"id": "d42", "who": "pip", "shot": "2-6", "t": 155.5, "text": "Pumpkin...", "emo": "low warning voice", "exag": 0.5, "cfg": 0.45},
  {"id": "d43", "who": "pumpkin", "shot": "2-6", "t": 157.5, "text": "One more test?", "emo": "sheepish, hopeful", "exag": 0.6, "cfg": 0.4},
  {"id": "d44", "who": "pip", "shot": "2-7", "t": 163.5, "text": "I told you not to eat it!", "emo": "shouting, exasperated", "exag": 0.8, "cfg": 0.35},
