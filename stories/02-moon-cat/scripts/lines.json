[
  {"id": "d01", "who": "pom", "shot": "03", "t": 17.0, "text": "Well, well. A moon nobody owns.", "emo": "sly, scheming, low", "exag": 0.6, "cfg": 0.4, "speed": 1.08, "pitch": 0.97},
  {"id": "d02", "who": "pom", "shot": "04", "t": 24.0, "text": "Then it might as well be mine.", "emo": "smug, delighted with himself", "exag": 0.65, "cfg": 0.4, "speed": 1.0, "pitch": 1.0},
  {"id": "d03", "who": "pom", "shot": "06", "t": 37.0, "text": "Roll up, roll up! One peek at the moon — only ONE acorn!", "emo": "showman, loud and excited", "exag": 0.9, "cfg": 0.3, "speed": 0.92, "pitch": 1.04},
  {"id": "d04", "who": "shell", "shot": "07", "t": 46.0, "text": "I've looked at that moon for two hundred years... for free.", "emo": "dry, tired, unimpressed", "exag": 0.35, "cfg": 0.5, "speed": 1.1, "pitch": 0.97},
  {"id": "d05", "who": "pom", "shot": "08", "t": 50.5, "text": "Ah, but that was the old moon, madam. This one is mine.", "emo": "oily salesman charm", "exag": 0.6, "cfg": 0.4, "speed": 1.0, "pitch": 1.02},
  {"id": "d06", "who": "frogs", "shot": "09", "t": 57.0, "text": "Ooooh... shiny.", "emo": "awed, dreamy", "exag": 0.7, "cfg": 0.4, "speed": 1.2, "pitch": 1.0},
  {"id": "d07", "who": "pip", "shot": "10", "t": 66.0, "text": "Who sold it to you?", "emo": "skeptical, deadpan", "exag": 0.45, "cfg": 0.5, "speed": 1.0, "pitch": 0.98},
  {"id": "d08", "who": "pom", "shot": "11", "t": 72.5, "text": "Nobody. I found it. Finders, keepers.", "emo": "dismissive, arrogant", "exag": 0.6, "cfg": 0.45, "speed": 0.95, "pitch": 1.0},
  {"id": "d09", "who": "pip", "shot": "11", "t": 76.6, "text": "Then I found it too. It's right there.", "emo": "matter-of-fact, gotcha", "exag": 0.55, "cfg": 0.45, "speed": 1.0, "pitch": 1.02},
  {"id": "d10", "who": "pom", "shot": "12", "t": 80.5, "text": "That's a... counterfeit moon. Very cheap. Very dangerous.", "emo": "flustered, making it up", "exag": 0.75, "cfg": 0.3, "speed": 0.95, "pitch": 1.05},
  {"id": "d11", "who": "pom", "shot": "14", "t": 93.0, "text": "New rule. No more free peeking over the fence.", "emo": "bossy, officious", "exag": 0.6, "cfg": 0.45, "speed": 1.0, "pitch": 1.0},
  {"id": "d12", "who": "bramble", "shot": "15", "t": 100.5, "text": "TWO acorns?! Yesterday it was ONE!", "emo": "outraged, shouting", "exag": 1.0, "cfg": 0.3, "speed": 0.9, "pitch": 1.06},
  {"id": "d13", "who": "pom", "shot": "16", "t": 107.5, "text": "Demand is high, my friend. The moon is very popular.", "emo": "smug, relaxed, mouth full", "exag": 0.55, "cfg": 0.45, "speed": 1.05, "pitch": 0.98},
  {"id": "d14", "who": "frogs", "shot": "18", "t": 121.0, "text": "It's... gone.", "emo": "shocked whisper", "exag": 0.5, "cfg": 0.4, "speed": 1.15, "pitch": 0.97},
  {"id": "d15", "who": "bramble", "shot": "19", "t": 126.5, "text": "Where's our MOON, cat?!", "emo": "furious roar", "exag": 1.0, "cfg": 0.3, "speed": 0.9, "pitch": 1.05},
  {"id": "d16", "who": "crowd", "shot": "19", "t": 129.5, "text": "Refund! Refund! Refund!", "emo": "angry chant", "exag": 0.9, "cfg": 0.35, "speed": 0.9, "pitch": 1.04},
  {"id": "d17", "who": "pom", "shot": "20", "t": 136.5, "text": "Stay calm! I'll... fetch it back!", "emo": "panicking, pretending to be calm", "exag": 0.85, "cfg": 0.3, "speed": 0.9, "pitch": 1.06},
  {"id": "d18", "who": "pom", "shot": "21", "t": 144.0, "text": "Come back, you ungrateful moon! I made you famous!", "emo": "desperate, yelling into the wind", "exag": 1.0, "cfg": 0.3, "speed": 0.92, "pitch": 1.06},
  {"id": "d19", "who": "pom", "shot": "23", "t": 158.0, "text": "...Help?", "emo": "tiny, sheepish", "exag": 0.3, "cfg": 0.5, "speed": 1.1, "pitch": 1.05},
  {"id": "d20", "who": "pip", "shot": "24", "t": 164.5, "text": "You can't lose the moon, Pom. You never had it.", "emo": "gentle, kind", "exag": 0.4, "cfg": 0.5, "speed": 1.08, "pitch": 0.98},
  {"id": "d21", "who": "shell", "shot": "26", "t": 178.5, "text": "There. Still free. Still mine. Still yours.", "emo": "warm, content", "exag": 0.45, "cfg": 0.5, "speed": 1.05, "pitch": 0.98},
  {"id": "d22", "who": "pom", "shot": "27", "t": 185.0, "text": "Right. Everyone... form a line. Refunds this way.", "emo": "humbled, sheepish", "exag": 0.4, "cfg": 0.5, "speed": 1.05, "pitch": 0.97},
  {"id": "d23", "who": "pom", "shot": "29", "t": 198.5, "text": "Well, well. A moon everybody owns.", "emo": "soft wonder, warm", "exag": 0.45, "cfg": 0.5, "speed": 1.08, "pitch": 0.98},
  {"id": "d24", "who": "pip", "shot": "29", "t": 202.0, "text": "Now you're getting it.", "emo": "teasing, fond", "exag": 0.5, "cfg": 0.45, "speed": 1.0, "pitch": 1.02},
  {"id": "d25", "who": "pom", "shot": "30", "t": 204.5, "text": "So. How much do you think I could get for the sun?", "emo": "sly, scheming again", "exag": 0.65, "cfg": 0.4, "speed": 1.05, "pitch": 0.98},
  {"id": "d26", "who": "pip", "shot": "30", "t": 208.0, "text": "POM.", "emo": "exasperated", "exag": 0.8, "cfg": 0.35, "speed": 1.0, "pitch": 1.04}
]
